#!/usr/sbin/nft -f

{% set devs    = networks[location].devices %}
{% set uplink  = networks[location].uplink.device %}
{% set untagged = devs | rejectattr('vlantag', 'defined')
                       | map(attribute='device')
                       | reject('equalto', uplink) | unique | list %}
{% set vlans    = devs | selectattr('vlantag', 'defined')
                       | map(attribute='vlantag') | unique | list %}

flush ruleset

include "{{ nftables_variables_file }}"

table ip global {
    chain inbound_world {
        # accepting ping (icmp-echo-request) for diagnostic purposes.
        # However, it also lets probes discover this host is alive.
        # This sample accepts them within a certain rate limit:
        #
        # icmp type echo-request limit rate 5/second accept

        # allow wireguard
        udp dport $WG_PORT_SOEREN_CLOUD accept

        # allow SSH connections from some well-known internet host
        ip saddr $WORLD_SSH_SOURCES tcp dport 22 accept
    }

    chain inbound_private {
        # accepting ping (icmp-echo-request) for diagnostic purposes.
        icmp type echo-request limit rate 5/second accept

        # allow DHCP, DNS and SSH from the private network
        ip saddr $NET_PRIVATE ip protocol . th dport vmap {
            tcp . 22 :   accept,
            tcp . 53 :   accept,
            udp . 53 :   accept,
            udp . 67 :   accept,
            udp . 123 :  accept
        }

        # allow access to haproxy that serves HA media and mpd
        ip saddr { $NET_DD_USERS, $POOL_MEDIA_TVBOXES, $POOL_MEDIA_MPD } tcp dport { 80, 445, 6600 } accept
        ip saddr $NET_SERVERS ip saddr @tag_prometheus tcp dport { 9093, 9100, 9167, 9192, 9194, 9443, 9823, 9865, 15283 } accept
    }

    chain inbound_wg {
        # accepting ping (icmp-echo-request) for diagnostic purposes.
        icmp type echo-request limit rate 5/second accept

        # allow DHCP, DNS and SSH from the private network
        ip protocol . th dport vmap {
            tcp . 22    : accept,
            tcp . 53    : accept,
            udp . 53    : accept,
            udp . 67    : accept,
            udp . 123   : accept
        }
    }

    chain inbound {
        type filter hook input priority 0; policy drop;

        # Allow traffic from established and related packets, drop invalid
        ct state vmap { established : accept, related : accept, invalid : drop }

        # allow loopback traffic, anything else jump to chain for further evaluation
        iifname vmap {
        lo : accept,
            $DEV_WORLD:    jump inbound_world,
            $WG_IF_SOEREN_CLOUD:        jump inbound_wg,
{% for v in vlans %},
            vlan{{ v }}: jump inbound_private
{%- endfor %}
        }

        # the rest is dropped by the above policy
    }

    chain forward {
        type filter hook forward priority 0; policy drop;
        # anti spoofing
        fib saddr . iif oif missing drop

        # Allow traffic from established and related packets, drop invalid
        ct state vmap { established : accept, related : accept, invalid : drop }

        #########################################################
        # allow all clients to talk to DNS servers over wireguard
        #########################################################
        ip saddr 192.168.64.0/21 oifname $WG_IF_SOEREN_CLOUD ip daddr { $IP_WG_SOEREN_CLOUD_RS, $TAG_WG_SOEREN_CLOUD_SEEDBOX } udp dport 53 accept
        ip saddr 192.168.64.0/21 oifname $WG_IF_SOEREN_CLOUD ip daddr { $IP_WG_SOEREN_CLOUD_RS, $TAG_WG_SOEREN_CLOUD_SEEDBOX } tcp dport 53 accept

        ################################################
        # USERS
        ################################################
        # allow soeren's desktop to access management network
        iifname $IF_USERS ip saddr $POOL_USERS_SOEREN ip saddr @tag_desktop oifname $IF_MANAGEMENT ip daddr $NET_MANAGEMENT accept

        # allow soeren pool to access everything
        iifname $IF_USERS ip saddr $POOL_USERS_SOEREN ip daddr != $NET_MANAGEMENT accept

        # allow access to kubernetes HTTPS
        iifname $IF_USERS ip saddr $NET_USERS oifname $IF_SERVERS ip daddr @tag_kubernetes tcp dport 443 accept

        # allow access to MPD
        iifname $IF_USERS ip saddr $NET_USERS oifname $IF_MEDIA ip daddr $POOL_MEDIA_MPD tcp dport 6600 accept

        # allow access to onkyo stereo
        iifname $IF_USERS ip saddr $NET_USERS oifname $IF_MEDIA ip daddr $POOL_MEDIA_APPLIANCES tcp dport 60128 accept

        # allow access to vacuum cleaner
        iifname $IF_USERS ip saddr $NET_USERS oifname $IF_IOT ip daddr $POOL_DD_IOT_VACUUM tcp dport { 80, 443 } accept

        #############################################
        # syncthing
        # allow local nas to talk to local syncthing
        #############################################
        iifname $IF_USERS ip saddr $NET_USERS oifname { $IF_SERVERS, $WG_IF_SOEREN_CLOUD } ip daddr @tag_nas tcp dport 22000 accept
        iifname $IF_USERS ip saddr $NET_USERS oifname { $IF_SERVERS, $WG_IF_SOEREN_CLOUD } ip daddr @tag_nas udp dport 22000 accept

        ################################################
        # SERVERS
        ################################################
        # allow prometheus to scrape node exporter port
        iifname $IF_SERVERS ip saddr $NET_SERVERS ip saddr @tag_prometheus oifname { $IF_IOT, $IF_MEDIA, $IF_MANAGEMENT, $WG_IF_SOEREN_CLOUD } tcp dport { 8405, 9100, 9167, 9443, 15283 } accept
        iifname $IF_SERVERS ip saddr $NET_SERVERS ip saddr @tag_prometheus oifname { $IF_IOT, $IF_MEDIA, $IF_MANAGEMENT, $WG_IF_SOEREN_CLOUD } icmp type echo-request accept

        # allow access to IOT devices
        iifname $IF_SERVERS ip saddr $NET_SERVERS ip saddr @tag_prometheus oifname {$IF_IOT, $WG_IF_SOEREN_CLOUD } ip daddr { $POOL_IOT_PI_ZERO, $POOL_PT_IOT_PI_ZERO } tcp dport { 9191, 9192, 9194, 9865 } accept

        # allow local nas to fetch data from seedbox
        iifname $IF_SERVERS ip saddr $NET_SERVERS ip saddr @tag_nas oifname $WG_IF_SOEREN_CLOUD ip daddr $TAG_WG_SOEREN_CLOUD_SEEDBOX tcp dport 22 accept

        # allow local nas to talk to remote syncthing
        iifname $IF_SERVERS ip saddr $NET_SERVERS ip saddr @tag_nas oifname { $IF_USERS, $WG_IF_SOEREN_CLOUD } ip daddr @tag_syncthing tcp dport 22000 accept
        iifname $IF_SERVERS ip saddr $NET_SERVERS ip saddr @tag_nas oifname { $IF_USERS, $WG_IF_SOEREN_CLOUD } ip daddr @tag_syncthing udp dport 22000 accept

        ################################################
        # IOT
        ################################################
        # allow access to mqtt server
        iifname $IF_IOT ip saddr $NET_IOT oifname $IF_SERVERS ip daddr $NET_SERVERS ip daddr @tag_mqtt tcp dport { 1883, 8883 } accept

        # allow access for raspberry PIs to openbao
        iifname $IF_IOT ip saddr $POOL_IOT_PI_ZERO oifname $IF_SERVERS ip daddr $POOL_SERVERS_OPENBAO_PRD tcp dport 443 accept

        ################################################
        # MEDIA
        ################################################
        # allow access to nas for media boxes
        iifname $IF_MEDIA ip saddr { $POOL_MEDIA_MPD, $POOL_MEDIA_TVBOXES } oifname $IF_SERVERS ip daddr @tag_nas tcp dport { 80, 443 } accept

        # allow access to openbao for raspberry PIs
        iifname $IF_MEDIA ip saddr $POOL_MEDIA_MPD oifname $IF_SERVERS ip daddr $POOL_SERVERS_OPENBAO_PRD tcp dport 443 accept

        ################################################
        # GUEST
        # allow access to kubernetes
        iifname $IF_GUEST ip saddr $NET_GUEST ip saddr $POOL_GUEST_WORK ip saddr @tag_soeren oifname { $IF_SERVERS, $WG_IF_SOEREN_CLOUD } ip daddr @tag_kubernetes tcp dport 443 accept

        # allow access to local openbao
        iifname $IF_GUEST ip saddr $NET_GUEST ip saddr $POOL_GUEST_WORK ip saddr @tag_soeren oifname $IF_SERVERS ip daddr $POOL_SERVERS_OPENBAO_PRD tcp dport 443 accept

        # allow access to syncthing
        iifname $IF_GUEST ip saddr $NET_GUEST ip saddr $POOL_GUEST_WORK ip saddr @tag_soeren oifname { $IF_SERVERS, $WG_IF_SOEREN_CLOUD } ip daddr @tag_nas tcp dport 22000 accept
        iifname $IF_GUEST ip saddr $NET_GUEST ip saddr $POOL_GUEST_WORK ip saddr @tag_soeren oifname { $IF_SERVERS, $WG_IF_SOEREN_CLOUD } ip daddr @tag_nas udp dport 22000 accept

        ################################################
        # CAM
        # allow cam access from soeren and ines over wireguard
        iifname $WG_IF_SOEREN_CLOUD ip saddr { $POOL_EZ_DEFAULT_USERS, $NET_PT_USERS, $NET_WG_SOEREN_CLOUD } ip saddr @tag_soeren oifname $IF_CAM ip daddr $NET_CAM accept
        iifname $WG_IF_SOEREN_CLOUD ip saddr { $POOL_EZ_DEFAULT_USERS, $NET_PT_USERS, $NET_WG_SOEREN_CLOUD } ip saddr @tag_ines   oifname $IF_CAM ip daddr $NET_CAM accept

        ################################################
        # Incoming Wireguard

        # allow access for remote nas to talk to local syncthing
        iifname $WG_IF_SOEREN_CLOUD ip saddr $NET_PRIVATE ip saddr @tag_nas oifname $IF_SERVERS ip daddr @tag_nas tcp dport 22000 accept
        iifname $WG_IF_SOEREN_CLOUD ip saddr $NET_PRIVATE ip saddr @tag_nas oifname $IF_SERVERS ip daddr @tag_nas udp dport 22000 accept

        # allow seedbox to talk to fetcharr on nas
        iifname $WG_IF_SOEREN_CLOUD ip saddr $TAG_WG_SOEREN_CLOUD_SEEDBOX oifname $IF_SERVERS ip daddr $NET_SERVERS ip daddr @tag_nas tcp dport {{ fetcharr_webhook_port }} accept

        # allow seedbox to talk to kubernetes services
        iifname $WG_IF_SOEREN_CLOUD ip saddr $TAG_WG_SOEREN_CLOUD_SEEDBOX oifname $IF_SERVERS ip daddr $NET_SERVERS ip daddr @tag_kubernetes tcp dport 443 accept

        # allow routers over wireguard to talk to nas
        iifname $WG_IF_SOEREN_CLOUD ip saddr { $IP_WG_SOEREN_CLOUD_EZ, $IP_WG_SOEREN_CLOUD_PT } oifname $IF_SERVERS ip daddr $NET_SERVERS ip daddr @tag_nas tcp dport { 80, 443, 445, 6600 } accept

        # deny internet to selected hosts
        ip saddr @tag_nointernet oifname $DEV_WORLD counter drop
        # allow forwarding
        iifname { $IF_USERS, $IF_SERVERS, $IF_IOT, $IF_MEDIA, $IF_GUEST, $IF_MANAGEMENT } oifname $DEV_WORLD ip saddr != @tag_nointernet counter accept

        # allow android tablet to talk to internet
        iifname { $IF_CAM } ip saddr $POOL_CAM_FRONTENDS ip daddr != 192.168.0.0/16 accept

        # the rest is dropped by the above policy
        log prefix drop-fwd  limit rate 1/minute
    }

    chain postrouting {
        type nat hook postrouting priority 100; policy accept;
        # masquerade private IP addresses
        ip saddr $NET_LOCAL oifname $DEV_WORLD masquerade
    }

    {% include 'nft_tags.j2' %}
}

table ip6 global {
    # Internet hosts allowed to SSH in over IPv6.
    # An empty set means no SSH over IPv6 at all; WireGuard still works.
    # Runtime edits: nft add element ip6 global world_ssh6 { 2001:db8::1 }
    set world_ssh6 {
        type ipv6_addr
        flags interval
        elements = { 2001:db8:1234::/48 }
    }

    chain inbound_world6 {
        # WireGuard, so peers can reach you on a v6-only network
        udp dport $WG_PORT_SOEREN_CLOUD accept

        ip6 saddr @world_ssh6 tcp dport 22 accept

        # DHCPv6 client / prefix delegation. Drop if your uplink is SLAAC-only.
        ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept

        # No echo-request here on purpose: the router does not answer pings
        # from the internet on its global address. Uncomment if you want it.
        # icmpv6 type echo-request limit rate 5/second accept

        # anything else falls through to the base chain's drop policy
    }

    chain inbound_lan6 {
        # The router runs no IPv6 services for the LAN. The only things
        # allowed are what SLAAC / DHCPv6 need, and they are all link-local.
        icmpv6 type echo-request limit rate 5/second accept

        # DHCPv6 server, if you run one (kea, dnsmasq --dhcp-range=::,...)
        ip6 saddr fe80::/10 udp sport 546 udp dport 547 accept

        # If your RAs advertise the router as a DNS server (RDNSS), clients
        # will resolve over IPv6 link-local and you need this. Better: turn
        # RDNSS off in radvd/dnsmasq and keep DNS on IPv4 as you intended.
        # ip6 saddr fe80::/10 ip protocol . th dport vmap { udp . 53 : accept, tcp . 53 : accept }
    }

    chain inbound6 {
        type filter hook input priority 0; policy drop;

        ct state vmap { established : accept, related : accept, invalid : drop }

        iifname lo accept

        # ICMPv6 error signalling: needed for the router's own outbound
        # connections, PMTU discovery in particular.
        icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem } accept

        # Neighbour and router discovery. hoplimit 255 proves it is on-link,
        # so this is safe to allow on every interface including the uplink.
        icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit, nd-router-advert } ip6 hoplimit 255 accept

        # MLD, always from link-local
        ip6 saddr fe80::/10 icmpv6 type { mld-listener-query, mld-listener-report, mld-listener-done, mld2-listener-report } accept

        iifname vmap {
            $DEV_WORLD            : jump inbound_world6,
{% for v in vlans %},
            vlan{{ v }}:          jump inbound_world6
{%- endfor %}
        }

        # $WG_IF_SOEREN_CLOUD is deliberately absent: the tunnel carries IPv4 only.

        log prefix drop-in6  level info limit rate 3/minute counter
    }

    chain forward6 {
        type filter hook forward priority 0; policy drop;

        ct state vmap { established : accept, related : accept, invalid : drop }

        # Packet-too-big has to get through or large transfers hang instead
        # of failing. ct related covers most of it; this is the safety net.
        # Rate is generous on purpose: dropping the overflow recreates the
        # PMTU blackhole this rule exists to prevent.
        icmpv6 type packet-too-big limit rate 100/second burst 50 packets accept

        # No IPv6 between private networks, or across the tunnel in either
        # direction. Rejected rather than dropped so a client that gets a
        # AAAA for something local fails instantly and falls back to IPv4
        # instead of sitting in a connect timeout.
        iifname { $IF_PRIVATE, $WG_IF_SOEREN_CLOUD } oifname { $IF_PRIVATE, $WG_IF_SOEREN_CLOUD } \
            reject with icmpv6 type admin-prohibited

        # The only thing IPv6 is for: LAN out to the internet.
        # Requiring a global unicast source keeps ULA and link-local from
        # leaking upstream and blocks the cruder spoofing attempts.
        iifname $IF_PRIVATE oifname $DEV_WORLD ip6 saddr 2000::/3 accept

        # Nothing accepts iifname $DEV_WORLD, so unsolicited internet traffic
        # to your LAN hits the drop policy. That is the point.

        log prefix drop-fwd6  level info limit rate 3/minute counter
    }
}
