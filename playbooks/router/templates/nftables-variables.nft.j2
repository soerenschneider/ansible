{#
    nftables variable definitions, derived from `networks` and
    `wireguard_networks`.

    Naming scheme -- every name carries the site, so a router can reference
    remote networks as easily as its own:

      VLAN_<SITE>_<SEG>              vlan tag            64
      NET_<SITE>_<SEG>               segment prefix      192.168.64.0/24
      IP_<SITE>_<SEG>                router's own addr   192.168.64.1
      POOL_<SITE>_<SEG>_<POOL>       pool prefix         192.168.65.128/29
      DHCP_<SITE>_<SEG>              dhcp scope          192.168.64.225-192.168.64.254
      NET_<SITE>                     all segments, merged
      NET_ALL                        every segment everywhere, merged

    WireGuard meshes are not sites, so they get their own namespace. Mesh
    names are always qualified -- there is deliberately no unsuffixed
    WG_IF or NET_WG:

      WG_IF_<MESH>                   tunnel device       wg0
      IP_WG_<MESH>                   router's own addr   192.168.200.3
      NET_WG_<MESH>                  mesh prefix         192.168.200.0/24
      WG_PORT_<MESH>                 listen port         12686
      POOL_WG_<MESH>_<POOL>          pool prefix         192.168.200.96/27
      IP_WG_<MESH>_<MEMBER>          one member's addr   192.168.200.5
      MEMBERS_WG_<MESH>_<POOL>       every addr in pool  { .1, .2, .3, .4, .5 }
      TAG_WG_<MESH>_<TAG>            every addr so tagged
      PEERS_WG_<MESH>                what THIS router peers with
      WG_IFS                         every local tunnel device

    Every member of every mesh is emitted, not just the local ones -- a
    rule on dd may well want to name ch's address. Pool and tag sets are
    the useful granularity: TAG_WG_SOEREN_CLOUD_SEEDBOX beats writing
    ch's /32 into a rule that stops being true when the seedbox moves.

    fw_tags merge: a member carries its pool's tags plus its own.

    The tunnel devices are derived entirely from `wireguard_networks`: a
    mesh member carrying `site: <this site>` IS this router's endpoint, and
    its interface name, address and prefix all follow from the mesh. There
    is no wg device in `networks` -- it would be a second copy of data the
    mesh already holds, and the two drifted.

      device   member.device | mesh.device | wg0
      address  member.logical / prefix of mesh.net

    Then unqualified aliases for the local site ({{ location }}), so rules
    about "here" stay readable.

    Symbol names are sanitised to [A-Z0-9_]: nft reads '.' as the
    concatenation operator, so a mesh called "soeren.cloud" must become
    SOEREN_CLOUD. For the same reason every interface *value* is quoted.

    Interface naming follows `ip link add ... name vlanN`, i.e. vlan64 and
    not enp2s0.64. A segment whose interface is named some other way can
    override it with `interface:` in the YAML.

    Rendered with ansible.builtin.template defaults (trim_blocks: yes).
#}
{% macro n(s) %}{{ s | string | upper | regex_replace('[^A-Z0-9]', '_') }}{% endmacro %}
{% macro ifname(dev) %}{% if dev.interface is defined %}{{ dev.interface }}{% elif dev.vlantag is defined %}vlan{{ dev.vlantag }}{% else %}{{ dev.device }}{% endif %}{% endmacro %}
{% set site_nets = [] %}
{% set uplink = networks[location].uplink.device %}
{#- ------------------------------------------------------------------ -#}
{#- This router's mesh endpoints: members whose `site` is this site.    -#}
{#- ------------------------------------------------------------------ -#}
{% set local_wg = [] %}
{% for mesh_name, mesh in (wireguard_networks | default({})) | dictsort %}
{% for pname, pool in (mesh.pools | default({})) | dictsort %}
{% for mname, member in (pool.hosts | default({})) | dictsort %}
{% if member.site | default('') == location %}
{{- local_wg.append({
      'mesh': mesh_name,
      'member': mname,
      'pool': pname,
      'device': member.device | default(mesh.device) | default('wg0'),
      'ip': member.logical,
      'net': mesh.net | default(''),
      'peers_with': member.peers_with | default('all'),
    }) or '' -}}
{% endif %}
{% endfor %}
{% endfor %}
{% endfor %}

{% for site, net in networks | dictsort %}
{% set segs = net.devices | default([]) | selectattr('address', 'defined') | list %}
{% if segs %}
###############################################################################
# site {{ site }}{% if site == location %} (local){% endif %}

###############################################################################
{% set cidrs = [] %}
{% for dev in segs %}
{% set seg = dev.name | default(dev.device) | default('unnamed') %}
{% set cidr = dev.address | ansible.utils.ipaddr('subnet') %}
{{- cidrs.append(cidr) or '' -}}

# {{ seg }}{% if dev.device is defined %} on {{ dev.device }}{% endif %}

{% if dev.vlantag is defined %}
define VLAN_{{ n(site) }}_{{ n(seg) }} = {{ dev.vlantag }}
{% endif %}
define NET_{{ n(site) }}_{{ n(seg) }} = {{ cidr }}
define IP_{{ n(site) }}_{{ n(seg) }} = {{ dev.address | ansible.utils.ipaddr('address') }}
{% if dev.dhcp is defined %}
define DHCP_{{ n(site) }}_{{ n(seg) }} = {{ dev.dhcp.from }}-{{ dev.dhcp.to }}
{% endif %}
{% for pname, pool in (dev.pools | default({})) | dictsort %}
{% if pool.cidr is defined %}
define POOL_{{ n(site) }}_{{ n(seg) }}_{{ n(pname) }} = {{ pool.cidr }}
{% endif %}
{% endfor %}

{% endfor %}
{% if cidrs %}
define NET_{{ n(site) }} = { {{ cidrs | ansible.utils.cidr_merge | join(', ') }} }
{{- site_nets.extend(cidrs) or '' -}}
{% endif %}

{% endif %}
{% endfor %}
###############################################################################
# wireguard meshes
###############################################################################
{% set mesh_nets = [] %}
{% for mesh_name, mesh in (wireguard_networks | default({})) | dictsort %}
{% set mk = n(mesh_name) | trim %}
{% set mesh_cidr = mesh.net | default('') %}
{% set tags = {} %}

#------------------------------------------------------------------------------
# mesh {{ mesh_name }}{% if mesh.hub is defined %} -- hub {{ mesh.hub }}{% endif %}

#------------------------------------------------------------------------------
{% if mesh_cidr | length > 0 %}
{{- mesh_nets.append(mesh_cidr) or '' -}}
define NET_WG_{{ mk }} = {{ mesh_cidr }}
{% endif %}
{% if mesh.port is defined %}
define WG_PORT_{{ mk }} = {{ mesh.port }}
{% endif %}
{% for pname, pool in (mesh.pools | default({})) | dictsort %}
{% set addrs = [] %}

# pool {{ pname }}
{% if pool.cidr is defined %}
define POOL_WG_{{ mk }}_{{ n(pname) }} = {{ pool.cidr }}
{% endif %}
{% for mname, member in (pool.hosts | default({})) | dictsort %}
{% if member.logical is defined %}
{{- addrs.append(member.logical) or '' -}}
{% for t in (pool.fw_tags | default([])) + (member.fw_tags | default([])) %}
{{- tags.setdefault(t, []).append(member.logical) or '' -}}
{% endfor %}
define IP_WG_{{ mk }}_{{ n(mname) }} = {{ member.logical }}
{% endif %}
{% endfor %}
{% if addrs %}
define MEMBERS_WG_{{ mk }}_{{ n(pname) }} = { {{ addrs | unique | join(', ') }} }
{% endif %}
{% endfor %}
{% if tags %}

# firewall tags
{% for t, addrs in tags | dictsort %}
define TAG_WG_{{ mk }}_{{ n(t) }} = { {{ addrs | unique | join(', ') }} }
{% endfor %}
{% endif %}

{% endfor %}
###############################################################################
# aggregates
###############################################################################
{% if site_nets %}
define NET_SITES = { {{ site_nets | ansible.utils.cidr_merge | join(', ') }} }
{% endif %}
{% if mesh_nets %}
define NET_MESH = { {{ mesh_nets | ansible.utils.cidr_merge | join(', ') }} }
{% endif %}
{% if site_nets or mesh_nets %}
define NET_ALL = { {{ (site_nets + mesh_nets) | ansible.utils.cidr_merge | join(', ') }} }
{% endif %}

###############################################################################
# local aliases for {{ location }}
###############################################################################
{% set local_devs = networks[location].devices | default([]) | selectattr('address', 'defined') | list %}
{% set priv_ifs = [] %}
{% set wg_ifs = [] %}
{% if local_devs %}
define NET_LOCAL = $NET_{{ n(location) }}
{% endif %}
{% for dev in local_devs %}
{% set seg = dev.name | default(dev.device) | default('unnamed') %}
{% if dev.device is defined and dev.device != uplink %}
{{- priv_ifs.append(ifname(dev) | string | trim) or '' -}}
{% endif %}

# {{ seg }}
{% if dev.vlantag is defined %}
define VLAN_{{ n(seg) }} = $VLAN_{{ n(location) }}_{{ n(seg) }}
{% endif %}
{% if dev.device is defined %}
define IF_{{ n(seg) }} = "{{ ifname(dev) | trim }}"
{% endif %}
define NET_{{ n(seg) }} = $NET_{{ n(location) }}_{{ n(seg) }}
define IP_{{ n(seg) }} = $IP_{{ n(location) }}_{{ n(seg) }}
{% for pname, pool in (dev.pools | default({})) | dictsort %}
{% if pool.cidr is defined %}
define POOL_{{ n(seg) }}_{{ n(pname) }} = $POOL_{{ n(location) }}_{{ n(seg) }}_{{ n(pname) }}
{% endif %}
{% endfor %}
{% endfor %}
{% for wg in local_wg %}
{{- wg_ifs.append(wg.device) or '' -}}


# tunnel endpoint -- {{ wg.device }} on mesh {{ wg.mesh }} as member {{ wg.member }}
define WG_IF_{{ n(wg.mesh) }} = "{{ wg.device }}"
define IP_WG_{{ n(wg.mesh) }} = {{ wg.ip }}
{% if wg.peers_with != 'all' %}
{% set reachable = [] %}
{% for pname, pool in (wireguard_networks[wg.mesh].pools | default({})) | dictsort %}
{% for mname, member in (pool.hosts | default({})) | dictsort %}
{% if mname in wg.peers_with and member.logical is defined %}
{{- reachable.append(member.logical) or '' -}}
{% endif %}
{% endfor %}
{% endfor %}
{% if reachable %}
# what {{ wg.member }} actually peers with -- tighter than the mesh prefix
define PEERS_WG_{{ n(wg.mesh) }} = { {{ reachable | unique | join(', ') }} }
{% endif %}
{% endif %}
{% endfor %}

###############################################################################
# interface groups
###############################################################################
define DEV_WORLD = "{{ uplink }}"
{% if priv_ifs %}
define IF_PRIVATE = { {% for i in priv_ifs | unique %}"{{ i }}"{{ ", " if not loop.last }}{% endfor %} }
{% endif %}
{% if wg_ifs %}
define WG_IFS = { {% for i in wg_ifs | unique %}"{{ i }}"{{ ", " if not loop.last }}{% endfor %} }
{% endif %}

###############################################################################
# static, from group_vars
###############################################################################
define NET_PRIVATE = 192.168.0.0/16
{% set rootservers = (enclave_ips | default({})) | dict2items | map(attribute='value') | list %}
{% if rootservers %}
define ROOTSERVERS = { {{ rootservers | join(', ') }} }
define WORLD_SSH_SOURCES = $ROOTSERVERS
{% endif %}
{% for name, value in (firewall.scalars | default({})) | dictsort %}
define {{ name }} = {{ value }}
{% endfor %}
{% for name, members in (firewall.sets | default({})) | dictsort %}
{% if members %}
define {{ name }} = { {{ members | join(', ') }} }
{% endif %}
{% endfor %}