MINIO_VOLUMES="{{ silo_volumes }}"
MINIO_OPTS="--address {{ silo_address }} --console-address {{ silo_console_address }} --certs-dir=/home/{{ silo_user }}/.silo/certs"

MINIO_SERVER_URL=https://{{ silo_server_url | default(inventory_hostname) }}
MINIO_BROWSER_REDIRECT_URL=https://{{ silo_browser_redirect_url | default(inventory_hostname) }}/silo-ui/

{% if silo_root_user | default('') | length > 0 %}
MINIO_ROOT_USER={{ silo_root_user }}
{% endif %}
{%- if silo_root_password | default('') | length > 0 %}
MINIO_ROOT_PASSWORD={{ silo_root_password }}
{% endif %}
