{#
    wg-quick config for a single mesh member.

    Set by tasks/wireguard.yml:
      wg_mesh_name   mesh key
      wg_mesh        wireguard_networks[wg_mesh_name]
      wg_member      this host's member name
      wg_members     flat map: member name -> member dict

    AllowedIPs, in order of precedence:

      me.allowed_ips_for.<peer>   explicit, per link -- replaces everything
      peer.allowed_ips            explicit for that member, on every link
      otherwise, derived:
        peer is the hub  -> the whole mesh net, so tunnel addresses with no
                            direct peering are relayed through it
        otherwise        -> the peer's /32
        plus that peer's site segments and its `allowed_extra`

    Additionally, a member that routes everything through the hub -- a
    roaming client -- gets every site's segments on its hub link. That is
    detected as: no `site` of its own AND peering with nothing but the hub.
    Override with `via_hub: true|false`.

    The "peers only with the hub" part matters. A relay such as ch has no
    `site` either, but peers directly with the site routers, so claiming
    every LAN on its hub link would overlap those direct peers -- and
    WireGuard requires AllowedIPs to be disjoint across peers on one
    interface, so one of them silently loses the route.

    A peer gets an Endpoint when it has one AND we are not listed as
    `no_dial` toward it. Peers we do not dial get PersistentKeepalive
    instead -- they dial in, and the keepalive holds the path open once a
    handshake has established their address. rs and ch never dial the site
    routers; the site routers dial them.

    Rendered with ansible.builtin.template defaults (trim_blocks: yes).
#}
{% macro site_nets(site) %}{{ (networks[site].devices | default([])
     | selectattr('address', 'defined')
     | rejectattr('mesh', 'defined')
     | map(attribute='address')
     | map('ansible.utils.ipaddr', 'subnet') | list) | to_json }}{% endmacro %}
{% set me = wg_members[wg_member] %}
{% set prefix = wg_mesh.net | ansible.utils.ipaddr('prefix') %}
{% set defaults = wg_mesh.defaults | default({}) %}
{#- Peer list: "all" means every other member. -#}
{% set peer_names = [] %}
{% if me.peers_with | default([]) == 'all' %}
{% for name in wg_members.keys() | list | sort %}
{% if name != wg_member %}
{{- peer_names.append(name) or '' -}}
{% endif %}
{% endfor %}
{% else %}
{% for name in me.peers_with | default([]) | sort %}
{{- peer_names.append(name) or '' -}}
{% endfor %}
{% endif %}
{#- Does this member route everything through the hub? True for a roaming
    client: no site of its own, and peering with nothing but the hub. NOT
    true for a relay like ch, which has no site but peers directly with the
    site routers -- claiming every LAN on its hub link would overlap those
    peers, and WireGuard needs AllowedIPs disjoint per interface. -#}
{% set via_hub = me.via_hub if me.via_hub is defined
                 else (me.site is not defined
                       and peer_names | reject('equalto', wg_mesh.hub) | list | length == 0) %}
{#- Every site's segments, for a member that routes them all via the hub. -#}
{% set all_site_nets = [] %}
{% for site in networks.keys() | list | sort %}
{{- all_site_nets.extend(site_nets(site) | from_json) or '' -}}
{% endfor %}
###############################################################################
# {{ wg_member }} ({{ inventory_hostname }}) on mesh {{ wg_mesh_name }}
#
# GENERATED by ansible from wireguard_networks. Do not edit on the host.
###############################################################################
[Interface]
Address = {{ me.logical }}/{{ prefix }}
PrivateKey = {{ (wg_privatekeys | default({})).get(wg_mesh_name, {}).get(inventory_hostname, '<<MISSING wg_privatekeys.' ~ wg_mesh_name ~ '.' ~ inventory_hostname ~ '>>') }}
ListenPort = {{ me.port | default(wg_mesh.port) }}
{% if me.mtu | default(defaults.mtu | default(false)) %}
MTU = {{ me.mtu | default(defaults.mtu) }}
{% endif %}
{% if me.dns is defined %}
DNS = {{ me.dns | join(', ') }}
{% endif %}
{% if me.postup is defined %}
PostUp = {{ me.postup }}
{% elif me.masquerade_out is defined %}
PostUp = iptables {{ me.iptables_opts | default('--wait ') }}-A FORWARD -i %i -j ACCEPT; iptables {{ me.iptables_opts | default('--wait ') }}-t nat -A POSTROUTING -o {{ me.masquerade_out }} -j MASQUERADE
{% endif %}
{% if me.postdown is defined %}
PostDown = {{ me.postdown }}
{% elif me.masquerade_out is defined %}
PostDown = iptables {{ me.iptables_opts | default('--wait ') }}-D FORWARD -i %i -j ACCEPT; iptables {{ me.iptables_opts | default('--wait ') }}-t nat -D POSTROUTING -o {{ me.masquerade_out }} -j MASQUERADE
{% endif %}
{% for name in peer_names %}
{% set peer = wg_members[name] %}
{% set allowed = [] %}
{% set override = (me.allowed_ips_for | default({})).get(name) or peer.allowed_ips | default(none) %}
{% if override %}
{{- allowed.extend(override) or '' -}}
{% else %}
{% if name == wg_mesh.hub %}
{{- allowed.append(wg_mesh.net) or '' -}}
{% if via_hub %}
{{- allowed.extend(all_site_nets) or '' -}}
{% endif %}
{% else %}
{{- allowed.append(peer.logical ~ '/32') or '' -}}
{% endif %}
{% if peer.site is defined %}
{{- allowed.extend(site_nets(peer.site) | from_json) or '' -}}
{% endif %}
{{- allowed.extend(peer.allowed_extra | default([])) or '' -}}
{% endif %}
{#- PSK: the two inventory hostnames, sorted, joined with '_'. -#}
{% set psk_key = [me.inventory_host | default(inventory_hostname), peer.inventory_host] | sort | join('_') %}
{% set psk = (wg_psks | default({})).get(wg_mesh_name, {}).get(psk_key) %}

[Peer]
# {{ name }}{% if peer.site is defined %} -- site {{ peer.site }}{% endif %}{% if name == wg_mesh.hub %} (hub){% endif %}

PublicKey = {{ (wg_pubkeys | default({})).get(wg_mesh_name, {}).get(peer.inventory_host, '<<MISSING wg_pubkeys.' ~ wg_mesh_name ~ '.' ~ peer.inventory_host ~ '>>') }}
AllowedIPs = {{ allowed | ansible.utils.cidr_merge | join(', ') }}
{% set dial = peer.endpoint is defined and name not in (me.no_dial | default([])) %}
{% if dial %}
Endpoint = {{ peer.endpoint }}:{{ peer.port | default(wg_mesh.port) }}
{% endif %}
{% if psk and name not in (me.no_psk_with | default([])) %}
PresharedKey = {{ psk }}
{% endif %}
{% if not dial %}
PersistentKeepalive = {{ peer.keepalive | default(defaults.keepalive | default(25)) }}
{% endif %}
{% endfor %}
