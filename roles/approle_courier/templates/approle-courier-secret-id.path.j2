# {{ ansible_managed }}
[Unit]
Description=Watch the AppRole secret_id of {{ approle_courier_service_name }}

[Path]
# Fires after the writer closes the file, also when it is replaced via rename.
PathChanged={{ approle_courier_secret_id_file }}
Unit={{ approle_courier_service_name }}-secret-id.service

[Install]
WantedBy=multi-user.target
