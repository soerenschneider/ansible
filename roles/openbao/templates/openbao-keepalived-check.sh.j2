#!/bin/sh
# {{ ansible_managed }}
#
# keepalived health check for the OpenBao VIP: succeeds while the local
# HAProxy is up and has at least one OpenBao node (unsealed, active or
# standby) passing its health check. Runs as {{ openbao_keepalived_script_user }}.
#
# Asks HAProxy's monitor endpoint on loopback instead of OpenBao itself, so
# the result does not depend on which node HAProxy would pick, a slow peer
# cannot fail the check on every node at once, and no TLS handshake is needed.
#
# --max-time stays below keepalived's timeout, so curl gives up on its own
# instead of being killed.
exec /usr/bin/curl \
  --silent \
  --fail \
  --proto '=http' \
  --max-time {{ [openbao_keepalived_check_timeout | int - 1, 1] | max }} \
  --output /dev/null \
  'http://127.0.0.1:{{ openbao_keepalived_check_port | int }}/healthz'
